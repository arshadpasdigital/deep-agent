{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "../..",
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": { "@/*": ["services/deepagent-service/src/*"] },
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../../packages/contracts/src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
