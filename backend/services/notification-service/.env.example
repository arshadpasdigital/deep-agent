NODE_ENV="development"
PORT=3003
GRPC_NOTIFICATION_PORT=50053
SHUTDOWN_TIMEOUT_MS=10000

# SMTP settings. For Gmail, use smtp.gmail.com:587 and an App Password.
# EMAIL_HOST and EMAIL_FROM are required in production; optional in development.
# Keep EMAIL_PASSWORD in your local .env; do not commit real credentials.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="Deep Agent <no-reply@example.com>"

RABBITMQ_URL=amqp://deepagent:local-development-only@localhost:5672
INTERNAL_SERVICE_TOKEN="local-development-only"
