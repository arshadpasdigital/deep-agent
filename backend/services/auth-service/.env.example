# Compose supplies PORT, MONGODB_URI, and RABBITMQ_URL for the local stack.
# Add auth-specific settings here when registration and JWT features are implemented.
JWT_ISSUER=deep-agent

NODE_ENV="development"
PORT=3001
GRPC_AUTH_PORT=50051
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
RABBITMQ_URL=amqp://deepagent:local-development-only@localhost:5672
MONGODB_URI=""