NODE_ENV="development"
PORT=3001
GRPC_AUTH_PORT=50051
SHUTDOWN_TIMEOUT_MS=10000

BETTER_AUTH_SECRET="replace-with-a-long-random-value"
# Public origin of the API gateway; cookies and OAuth redirects use this value.
BETTER_AUTH_URL="http://localhost:8080"
MONGODB_URI="mongodb://deepagent:local-development-only@localhost:27017/deep_agent?authSource=admin"
RABBITMQ_URL="amqp://deepagent:local-development-only@localhost:5672"

# Browser origins allowed to call the auth endpoints (comma-separated).
TRUSTED_ORIGINS="http://localhost:5173"

# Google OAuth. Set both values or leave both empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Internal notification service used for OTP delivery.
NOTIFICATION_SERVICE_URL="http://localhost:3003"
INTERNAL_SERVICE_TOKEN="local-development-only"
