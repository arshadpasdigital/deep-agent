# Configure model credentials here when agent execution is implemented.
MODEL_PROVIDER=
MODEL_API_KEY=

NODE_ENV="development"
PORT=3002
GRPC_DEEP_AGENT_PORT=50052

# Memory backend: "mongo" (durable, required in production) or "memory" (process-only, tests/dev)
MEMORY_BACKEND=mongo
MONGODB_URI="mongodb://localhost:27017/deep-agent"
MEMORY_CHECKPOINT_DB=deepagent_checkpoints
MEMORY_STORE_DB=deepagent_memory